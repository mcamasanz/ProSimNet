{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(python -m pytest*)",
      "Bash(python -c*)",
      "Bash(jupyter nbconvert*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(cat*)",
      "Bash(wc*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(rm -rf*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys, os; f=os.environ.get('CLAUDE_TOOL_INPUT_FILE_PATH',''); print('[HOOK] RHS modificado — ejecuta /check-rhs para auditar la física') if 'rhs_' in f else None\""
          }
        ]
      }
    ]
  }
}
